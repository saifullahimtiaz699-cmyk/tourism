# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tourism
# MONGODB_URI is also accepted for Atlas-generated environment files.

# Local default is 5000; Render supplies PORT automatically
PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed to call the API
FRONTEND_URL=http://localhost:5173

# Frontend API base URL, without a trailing slash
VITE_API_URL=http://localhost:5000/api
